{
    "name": "krx-invest-web",
    "version": "1.0.0",
    "description": "KRX 투자경고/주의 조건 분석기 - 프로덕션 서버",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "server": "nodemon server.js --ignore public/",
        "browser": "browser-sync start --proxy \"localhost:3001\" --files \"public/**/*\"",
        "dev": "concurrently \"npm run server\" \"npm run browser\"",
        "build": "echo 'No build step required for this Node.js project. Ready for production.'",
        "pm2": "pm2 start ecosystem.config.js"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "node-cache": "^5.1.2"
    },
    "devDependencies": {
        "browser-sync": "^3.0.4",
        "concurrently": "^9.2.1",
        "nodemon": "^3.1.14"
    }
}